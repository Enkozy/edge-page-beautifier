{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "Edge页面美化",
  "version": "1.2.6",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "optional_permissions": ["topSites"],
  "host_permissions": [
    "https://*.bing.com/*",
    "https://bing.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Edge 页面美化",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bing.com/*",
        "https://bing.com/*",
        "http://*.bing.com/*",
        "http://bing.com/*"
      ],
      "css": ["src/glass.css"],
      "js": ["src/settings.js", "src/glass.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
